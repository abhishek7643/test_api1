# Database
DB_NAME=api_testing_tool
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Optional custom Clerk JWKS URL (auto-derived from publishable key if omitted)
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Proxy
PROXY_TIMEOUT=30


# Email Configuration
# For local dev / testing, console backend prints emails to your terminal:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password_or_app_password
DEFAULT_FROM_EMAIL=API Studio <noreply@example.com>
EMAIL_VERIFICATION_TIMEOUT=86400

